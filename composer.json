{
    "name": "hibira-io/filament",
    "description": "Live database notifications, an Echo connection light and a live channels widget for Filament panels, on Hibira",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "broadcasting",
        "websockets",
        "realtime",
        "notifications",
        "echo",
        "hibira"
    ],
    "homepage": "https://hibira.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Hibira",
            "homepage": "https://hibira.io"
        }
    ],
    "support": {
        "issues": "https://github.com/hibira-io/filament/issues",
        "docs": "https://github.com/hibira-io/filament#readme",
        "email": "support@hibira.io"
    },
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0|^4.0|^5.0",
        "hibira-io/laravel": "^0.1",
        "pusher/pusher-php-server": "^7.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hibira\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hibira\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hibira\\Filament\\HibiraFilamentServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
